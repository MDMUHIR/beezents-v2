# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Base URL of the backend API service. The client appends
# /api/v1 endpoints.
# - Local development: use /backend so the Vite dev proxy keeps the HTTP-only
#   session cookie first-party to the frontend.
# - Production: use the real backend origin, e.g. https://api.beezents.com
#   (set this in .env.production or the deployment environment).
VITE_API_BASE_URL="/backend"

# VITE_API_PROXY_TARGET: Actual backend origin used by the Vite dev proxy.
VITE_API_PROXY_TARGET="http://localhost:8000"

# Configure the backend CORS allowlist for this origin and enable credentials.
# Example backend value: CORS_ALLOWED_ORIGINS=http://localhost:3000
