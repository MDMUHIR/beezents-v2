# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: URL prefix used by the browser. Use /backend in local
# development so the HTTP-only session cookie is first-party to the frontend.
VITE_API_BASE_URL="/backend"

# VITE_API_PROXY_TARGET: Actual backend origin used by the Vite dev proxy.
VITE_API_PROXY_TARGET="http://localhost:8000"

# Configure the backend CORS allowlist for this origin and enable credentials.
# Example backend value: CORS_ALLOWED_ORIGINS=http://localhost:3000
